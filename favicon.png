<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="furGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFA726"/>
      <stop offset="100%" style="stop-color:#FB8C00"/>
    </linearGradient>
    <radialGradient id="eyeGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#4CAF50"/>
      <stop offset="100%" style="stop-color:#2E7D32"/>
    </radialGradient>
  </defs>
  
  <!-- Head -->
  <circle cx="32" cy="34" r="20" fill="url(#furGrad)"/>
  
  <!-- Ears -->
  <path d="M 16 22 L 12 8 L 24 16 Z" fill="#FFB74D" stroke="#F57C00" stroke-width="1.5"/>
  <path d="M 48 22 L 52 8 L 40 16 Z" fill="#FFB74D" stroke="#F57C00" stroke-width="1.5"/>
  
  <!-- Eyes -->
  <ellipse cx="25" cy="32" rx="4.5" ry="5" fill="url(#eyeGrad)"/>
  <ellipse cx="25" cy="32" rx="2" ry="3.5" fill="#1B5E20"/>
  <circle cx="26.5" cy="30.5" r="1.5" fill="#FFF"/>
  
  <ellipse cx="39" cy="32" rx="4.5" ry="5" fill="url(#eyeGrad)"/>
  <ellipse cx="39" cy="32" rx="2" ry="3.5" fill="#1B5E20"/>
  <circle cx="40.5" cy="30.5" r="1.5" fill="#FFF"/>
  
  <!-- Nose -->
  <path d="M 30 38 Q 32 36.5 34 38 Q 32 40 30 38" fill="#FF8A80"/>
  
  <!-- Mouth -->
  <path d="M 32 39.5 Q 30 41 28 40" fill="none" stroke="#5D4037" stroke-width="1.2"/>
  <path d="M 32 39.5 Q 34 41 36 40" fill="none" stroke="#5D4037" stroke-width="1.2"/>
  
  <!-- Whiskers -->
  <line x1="18" y1="36" x2="8" y2="34" stroke="#5D4037" stroke-width="0.8" opacity="0.6"/>
  <line x1="18" y1="38" x2="7" y2="38" stroke="#5D4037" stroke-width="0.8" opacity="0.6"/>
  <line x1="18" y1="40" x2="8" y2="42" stroke="#5D4037" stroke-width="0.8" opacity="0.6"/>
  <line x1="46" y1="36" x2="56" y2="34" stroke="#5D4037" stroke-width="0.8" opacity="0.6"/>
  <line x1="46" y1="38" x2="57" y2="38" stroke="#5D4037" stroke-width="0.8" opacity="0.6"/>
  <line x1="46" y1="40" x2="56" y2="42" stroke="#5D4037" stroke-width="0.8" opacity="0.6"/>
</svg>
